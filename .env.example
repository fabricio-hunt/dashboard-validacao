# ==============================================================================
# SMARTPOS & ERP CONFIGURATION
# ==============================================================================
SMARTPOS_BASE_URL=https://api.smartpos.app/v1
SMARTPOS_KEY_ID=
SMARTPOS_KEY_SECRET=

# Parâmetros analíticos do dashboard
STOCK_EXCESS_MULTIPLIER=3
CONTAS_A_RECEBER_VALOR=51489.41

# Modo de operação: 'api'
NEXT_PUBLIC_DATA_SOURCE=api

# ==============================================================================
# AJUSTE MANUAL DE ESTOQUE (persistência durável via GitHub Contents API)
# ==============================================================================
# PAT fine-grained com escopo "Contents: Read and write" apenas neste repositório.
GITHUB_WRITE_TOKEN=
GITHUB_REPO=fabricio-hunt/dashboard-validacao
GITHUB_BRANCH=main
# Mesmo Deploy Hook já usado pelo workflow de sync diário (opcional, mas recomendado).
VERCEL_DEPLOY_HOOK_URL=
# Senha simples exigida pela tela de "Ajustar saldo físico" no Dashboard (não é um login completo).
INVENTORY_ADJUST_TOKEN=

# ==============================================================================
# METAS COMERCIAIS (persistência durável via GitHub Contents API)
# ==============================================================================
# Senha simples exigida para cadastrar/editar metas mensais de faturamento no Dashboard
# (aba "Indicadores Comerciais"). Dedicada e separada do INVENTORY_ADJUST_TOKEN.
SALES_GOALS_EDIT_TOKEN=

# ==============================================================================
# DECREMENTO AUTOMÁTICO DE ESTOQUE POR VENDAS (cron)
# ==============================================================================
# Protege /api/cron/stock-decrement contra chamadas externas. A Vercel preenche esse valor
# automaticamente como header Authorization em cron jobs configurados em vercel.json.
CRON_SECRET=

# ==============================================================================
# STRIPE PAYMENTS & MAINTENANCE SUBSCRIPTION (OPCIONAL)
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MAINTENANCE=price_...
