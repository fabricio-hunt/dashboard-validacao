# ==============================================================================
# SMARTPOS & ERP CONFIGURATION
# ==============================================================================
# URL base oficial da API SmartPOS: https://api.smartpos.app/v1
SMARTPOS_BASE_URL=https://api.smartpos.app/v1

# Identificador da chave de API (X-Api-Key-Id) gerado no SmartPOS WEB
# Exemplo: 2735d1d6-b987-4a3f-853d-dfb4a58bc2a5
SMARTPOS_KEY_ID=

# Chave secreta de API (X-Api-Key-Secret) exibida temporariamente ao criar a chave
SMARTPOS_KEY_SECRET=

# Modo de operação do Dashboard: 'excel' (padrão para validação) ou 'api'
NEXT_PUBLIC_DATA_SOURCE=excel
