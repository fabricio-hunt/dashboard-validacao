# Configuração da Fonte de Dados
# Opções: "spreadsheet" (Modo Demonstração com 251 SKUs) | "api" (Modo Produção com API do Cliente)
NEXT_PUBLIC_DATA_SOURCE="spreadsheet"

# Credenciais da API Oficial do Cliente (Fase 2 - Pós Aprovação)
CLIENT_API_BASE_URL="https://api.erp-cliente.com.br/v1"
CLIENT_API_KEY="sua_chave_ou_token_aqui"
